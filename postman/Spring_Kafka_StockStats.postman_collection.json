{
	"info": {
		"_postman_id": "spring-kafka-stockstats-api",
		"name": "Spring Kafka Streams StockStats API",
		"description": "Postman collection for testing the Spring Boot Kafka Streams Stock Statistics application (generator, manual publishing, live aggregation metrics, and RocksDB state store queries).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8082",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Trade Generator Control",
			"item": [
				{
					"name": "Get Generator Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/stocks/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "status"]
						},
						"description": "Checks if the background trade generator is currently running and returns the total number of recent window aggregations received."
					},
					"response": []
				},
				{
					"name": "Start Trade Generator",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/stocks/generator/start",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "generator", "start"]
						},
						"description": "Starts the simulated stock trade generator producing trades for 10 tickers to the 'stocks' topic."
					},
					"response": []
				},
				{
					"name": "Stop Trade Generator",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/stocks/generator/stop",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "generator", "stop"]
						},
						"description": "Stops/pauses the automatic trade generation."
					},
					"response": []
				},
				{
					"name": "Toggle Trade Generator",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/stocks/generator/toggle",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "generator", "toggle"]
						},
						"description": "Toggles the automatic trade generator state (ON -> OFF or OFF -> ON)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Trade Publishing",
			"item": [
				{
					"name": "Send Trade - AAPL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"ASK\",\n    \"ticker\": \"AAPL\",\n    \"price\": 175.50,\n    \"size\": 50\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/stocks/trade",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "trade"]
						},
						"description": "Manually publishes a custom trade to the 'stocks' Kafka topic."
					},
					"response": []
				},
				{
					"name": "Send Trade - MMM",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"ASK\",\n    \"ticker\": \"MMM\",\n    \"price\": 5025.75,\n    \"size\": 100\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/stocks/trade",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "trade"]
						},
						"description": "Manually publishes a trade for ticker MMM to the 'stocks' Kafka topic."
					},
					"response": []
				}
			]
		},
		{
			"name": "Streams Aggregation Output",
			"item": [
				{
					"name": "Get Recent Window Aggregations",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/stocks/stats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "stats"]
						},
						"description": "Returns the latest window aggregations (count, min price, max price, average price, window timestamps) computed by Kafka Streams and received on 'stockstats-output'."
					},
					"response": []
				}
			]
		},
		{
			"name": "RocksDB State Store (Interactive Queries)",
			"item": [
				{
					"name": "Query All Windows in RocksDB",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/stocks/store?minutes=30",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "store"],
							"query": [
								{
									"key": "minutes",
									"value": "30"
								}
							]
						},
						"description": "Queries the local embedded RocksDB window store ('trade-aggregates') directly via Kafka Streams Interactive Queries API."
					},
					"response": []
				},
				{
					"name": "Query Ticker in RocksDB - AAPL",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/stocks/store/AAPL?minutes=30",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "store", "AAPL"],
							"query": [
								{
									"key": "minutes",
									"value": "30"
								}
							]
						},
						"description": "Queries all active/recent time windows for AAPL directly from the local RocksDB state store."
					},
					"response": []
				},
				{
					"name": "Query Ticker in RocksDB - MMM",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/stocks/store/MMM?minutes=30",
							"host": ["{{baseUrl}}"],
							"path": ["api", "stocks", "store", "MMM"],
							"query": [
								{
									"key": "minutes",
									"value": "30"
								}
							]
						},
						"description": "Queries all active/recent time windows for MMM directly from the local RocksDB state store."
					},
					"response": []
				}
			]
		}
	]
}
